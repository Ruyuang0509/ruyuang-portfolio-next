---
const { subpage = false } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<footer class="outbus">
  <div class="inner">
    <div class="panel-body">
      {!subpage && <p class="statement">「先讓路途平坦，<br />再思考如何裝飾風景。」</p>}<!-- 回饋:內頁頁尾不掛 slogan;標點全形(K-67 稽核) -->
      <!-- 原本是純裝飾卻長著推桿的臉(使用者回饋:誤導有互動)——改成真控制:訊號送出後,回到源頭 -->
      <button class="busline" type="button" data-bus-top aria-label="回到頁面頂端">
        <span>OUTPUT BUS</span><span class="rail" aria-hidden="true"></span><span>RETURN ↑</span>
      </button>
      <div class="foot-row">
        <a href="https://github.com/ruyuang0509/ruyuang-portfolio-next">GITHUB</a>
        <a href={`${base}/research/`}>研究筆記</a>
        <a href={subpage ? `${base}/design/journey-proto-1.html` : "#console"}>{subpage ? "回到旅程" : "回訊號路徑"}</a>
        <span>© 2026 如願 · 本站無廣告、無付費牆、無聯盟收益</span>
      </div>
    </div>
  </div>
</footer>

<script>
  document.querySelectorAll("[data-bus-top]").forEach((b) =>
    b.addEventListener("click", () =>
      scrollTo({
        top: 0,
        behavior: matchMedia("(prefers-reduced-motion: reduce)").matches ? "auto" : "smooth",
      })
    )
  );
</script>
