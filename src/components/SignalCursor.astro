---
// 訊號游標的內頁接手(K-62 續,回饋:光標沒被帶進 DOSSIER):
// 旅程頁把 sessionStorage sig="1" 當接力棒;內頁只在「訊號仍在旅途中」時接手。
// "sent"=謝幕已送出,不再出現;僅 pointer:fine+非低敏。
---

<style is:global>
  html.signal-cursor,
  html.signal-cursor * { cursor: none !important; }
  .sig-cursor {
    position: fixed; left: 0; top: 0; width: 10px; height: 10px; border-radius: 50%;
    background: var(--color-accent); pointer-events: none; z-index: 72; margin: -5px 0 0 -5px;
    box-shadow: 0 0 6px 1px color-mix(in oklab, var(--color-accent) 60%, transparent);
    transition: width .18s ease, height .18s ease, margin .18s ease,
      background .18s ease, border .18s ease, opacity .25s linear;
  }
  .sig-cursor.ring { width: 26px; height: 26px; margin: -13px 0 0 -13px; background: transparent; border: 1.5px solid var(--color-accent); }
  .sig-cursor.hidden { opacity: 0; }
  .sig-trail { position: fixed; left: 0; top: 0; width: 5px; height: 5px; border-radius: 50%;
    background: var(--color-accent); pointer-events: none; z-index: 71; margin: -2.5px 0 0 -2.5px; }
  .sig-click { position: fixed; left: 0; top: 0; width: 14px; height: 14px; margin: -7px 0 0 -7px;
    border-radius: 50%; border: 1.5px solid var(--color-accent); pointer-events: none; z-index: 71; }
</style>

<script>
  const FINE = matchMedia("(pointer: fine)").matches;
  const RM = matchMedia("(prefers-reduced-motion: reduce)").matches;
  let flag = null;
  try { flag = sessionStorage.getItem("sig"); } catch {}
  if (FINE && !RM && flag === "1") {
    let sig: HTMLSpanElement | null = null, x = 0, y = 0, tx = 0, ty = 0, on = false;
    let tick = 0;
    const loop = () => {
      if (!on || !sig) return;
      const px = x, py = y;
      x += (tx - x) * 0.2; y += (ty - y) * 0.2;
      sig.style.transform = `translate(${x}px,${y}px)`;
      if (Math.hypot(x - px, y - py) > 5 && (++tick & 1) === 0) {
        const t = document.createElement("span");
        t.className = "sig-trail";
        document.body.appendChild(t);
        t.animate(
          [{ transform: `translate(${x}px,${y}px) scale(1)`, opacity: 0.5 },
           { transform: `translate(${x}px,${y}px) scale(0.25)`, opacity: 0 }],
          { duration: 380, easing: "ease-out", fill: "both" }
        ).onfinish = () => t.remove();
      }
      requestAnimationFrame(loop);
    };
    addEventListener("pointerdown", (e) => {
      if (!on || !sig) return;
      sig.animate([{ opacity: 1 }, { opacity: 0.3 }, { opacity: 1 }], { duration: 170, easing: "ease-out" });
      const ring = document.createElement("span");
      ring.className = "sig-click";
      document.body.appendChild(ring);
      ring.animate(
        [{ transform: `translate(${e.clientX}px,${e.clientY}px) scale(0.4)`, opacity: 0.9 },
         { transform: `translate(${e.clientX}px,${e.clientY}px) scale(3.4)`, opacity: 0 }],
        { duration: 400, easing: "cubic-bezier(.22,1,.36,1)", fill: "both" }
      ).onfinish = () => ring.remove();
    });
    addEventListener(
      "pointermove",
      (e) => {
        tx = e.clientX; ty = e.clientY;
        if (!on) {
          on = true;
          sig = document.createElement("span");
          sig.className = "sig-cursor";
          x = tx; y = ty;
          sig.style.transform = `translate(${x}px,${y}px)`;
          document.body.appendChild(sig);
          document.documentElement.classList.add("signal-cursor");
          requestAnimationFrame(loop);
        }
        const t = e.target as Element | null;
        sig!.classList.toggle("ring", !!(t && t.closest && t.closest("a,button,input,select,textarea,video")));
      },
      { passive: true }
    );
    document.documentElement.addEventListener("mouseleave", () => sig && sig.classList.add("hidden"));
    document.documentElement.addEventListener("mouseenter", () => sig && sig.classList.remove("hidden"));
  }
</script>
