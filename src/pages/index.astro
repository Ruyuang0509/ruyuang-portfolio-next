    }));

  // 先到者定位實驗：同一 click 左右各一發，時間差由推桿決定(規格:≤1ms 疊加/≤50ms 融合/>50ms 回聲)
  function haasClick(pan, when){
    const o = ctx.createOscillator(), g = ctx.createGain(), p = ctx.createStereoPanner();
    o.type = "triangle"; o.frequency.value = 1100;
    g.gain.setValueAtTime(0, when);
    g.gain.linearRampToValueAtTime(.26, when + .002);
    g.gain.exponentialRampToValueAtTime(.001, when + .06);
    p.pan.value = pan;
    o.connect(g); g.connect(p); p.connect(analyser);
    o.start(when); o.stop(when + .08);
  }
  function haasZone(ms){
    if (ms <= 1)  return "疊加：兩發合成一聲";
    if (ms <= 50) return "融合：方向跟著先到的左邊";
    return "拆開：右邊變成回聲";
  }
