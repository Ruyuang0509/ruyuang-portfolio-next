  }, { passive: true });
  addEventListener("pointerdown", (e) => { // 左鍵回饋(回饋4):游標短促減光+觸發環盪開——儀器的「按下」感
    if (!sigOn || !sig || sig.classList.contains("hidden")) return;
    sig.animate([{ opacity: 1 }, { opacity: .3 }, { opacity: 1 }], { duration: 170, easing: "ease-out" });
    const ring = document.createElement("span");
    ring.className = "sig-click";
    document.body.appendChild(ring);
    ring.animate([
      { transform: "translate(" + e.clientX + "px," + e.clientY + "px) scale(.4)", opacity: .9 },
      { transform: "translate(" + e.clientX + "px," + e.clientY + "px) scale(3.4)", opacity: 0 }
    ], { duration: 400, easing: "cubic-bezier(.22,1,.36,1)", fill: "both" }).onfinish = () => ring.remove();
  });
  document.documentElement.addEventListener("mouseleave", () => { if (sig) sig.classList.add("hidden"); });
  document.documentElement.addEventListener("mouseenter", () => { if (sig) sig.classList.remove("hidden"); });
  function ensureSignal(){ // 回饋2:bail、入站秒滾、深處重整——訊號都要吸附上手;唯「已送出」不回頭
    if (!FINE || reduceMotion || sigOn) return;
    let st = null; try { st = sessionStorage.getItem("sig"); } catch {}
    if (st === "sent") return;
    if (ptrSeen) attachSignal(tX, tY);
    else addEventListener("pointermove", (e) => { if (!sigOn) attachSignal(e.clientX, e.clientY); }, { once: true, passive: true });
  }

  // ---- 開機閘:載入儀式(Bruno 式「按下開始」)。跳過/Esc/直接捲動皆離開;讀數是真實就緒訊號 ----
  const gate = $("gate");
  let gateDismissed = false;
  let gateY0 = null, gateT0 = 0; // T0 在開閘時錨定——錨在解析時的話,載入慢一點還原窗就已過期
  // 位置還原可能連射多發(y=0 先毒化基準,跳位那發就誤殺閘)——開閘後 500ms 內一律只更新基準;
  // 之後偏移 >40 才是使用者要離開(深處重整「必演」的最後一塊)
  function gateScrollDismiss(){
    if (performance.now() - gateT0 < 500){ gateY0 = scrollY; return; }
    if (gateY0 === null) { gateY0 = scrollY; return; }
    if (Math.abs(scrollY - gateY0) > 40) dismissGate();
  }
  function flipDotToHook(){ // 閘的光點飛去 hook 落位(FLIP):同一顆訊號,從儀式接進頁面
    const gd = gate.querySelector(".gate-core .dot"), hd = $("hookDot");
    if (!gd || !hd) return;
    // 批判修正三件:bloom 的 fill 蓋得住 inline opacity(先 cancel);量測前停掉呼吸
    // (相位會烙進快照,±1.5px);目的地在飛行中先藏起來(否則兩顆 dot 同屏)
    gd.getAnimations().forEach((an) => an.cancel());
    gd.style.opacity = "0";
    // K-62:有指標就飛向游標(訊號交到你手裡);無指標(鍵盤/觸控)退回原路=飛向 hook 光點
    const toCursor = FINE && !reduceMotion && ptrSeen;
    hd.style.animation = "none";
    const a = gd.getBoundingClientRect();
    const b = toCursor ? { left: tX - 5, top: tY - 5, width: 10, height: 10 } : hd.getBoundingClientRect();
    if (!toCursor) hd.style.opacity = "0";
    const c = document.createElement("span");
    c.className = "dot";
    c.style.cssText = "position:fixed;left:" + a.left + "px;top:" + a.top + "px;width:" + a.width + "px;height:" + a.height + "px;z-index:71;margin:0;pointer-events:none;transform-origin:top left";
    document.body.appendChild(c);
    const restore = () => { hd.style.opacity = ""; hd.style.animation = ""; };
    const anim = c.animate([
      { transform: "translate(0,0) scale(1)" },
      { transform: "translate(" + (b.left - a.left) + "px," + (b.top - a.top) + "px) scale(" + (b.width / a.width) + ")" }
    ], { duration: 680, easing: "cubic-bezier(.22,1,.36,1)", fill: "forwards" });
    // 火花尾跡:訊號劃過黑場(沿 clone 即時位置生成,結束自清)
    const trail = setInterval(() => {
      const r = c.getBoundingClientRect();
      const sp = document.createElement("span");
      sp.className = "dot";
      sp.style.cssText = "position:fixed;left:" + r.left + "px;top:" + r.top + "px;width:4px;height:4px;z-index:70;margin:0;pointer-events:none;box-shadow:none";
      document.body.appendChild(sp);
      sp.animate([{ opacity: .8, transform: "scale(1)" }, { opacity: 0, transform: "scale(.3)" }],
        { duration: 480, easing: "ease-out" }).onfinish = () => sp.remove();
    }, 70);
    const onScroll = () => { clearInterval(trail); anim.cancel(); c.remove(); restore(); }; // 目標座標過期,中止不硬著陸
    addEventListener("scroll", onScroll, { once: true, passive: true });
    anim.onfinish = () => {
      removeEventListener("scroll", onScroll);
      clearInterval(trail);
      c.remove(); restore();
      if (toCursor){ attachSignal(tX, tY); } // 訊號附著為游標——旅程從你手上開始
      // 落地:光點脈衝+擴散環+訊號線點亮(開機時由 powerOnSound 經 analyser 點亮=同源;安靜路徑手動短湧)
      if (!toCursor) hd.animate([{ transform: "scale(1)" }, { transform: "scale(1.6)" }, { transform: "scale(1)" }],
        { duration: 560, easing: "ease-out" });
