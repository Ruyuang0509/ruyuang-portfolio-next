    document.documentElement.classList.add("signal-cursor"); // 原生游標只在跟隨者活著時隱藏
    sigRaf = requestAnimationFrame(sigLoop);
  }
  function detachSignal(){ // 取回跟隨者(還原生游標);回傳最後位置供謝幕演出接手
    if (!sigOn) return null;
    try { sessionStorage.setItem("sig", "sent"); } catch {} // 已送出:本 session 不再自動附著
    sigOn = false;
