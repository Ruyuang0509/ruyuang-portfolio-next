    $("haasMs").textContent = e.target.value + " ms";
    $("haasRead").textContent = haasZone(+e.target.value);
  });
  $("haasBtn").addEventListener("click", () => {
    if (!powered || !ctx) return;
    const t = ctx.currentTime + .05, d = (+$("haasDelay").value) / 1000;
    haasClick(-0.9, t); haasClick(0.9, t + d);
    kick();
  });

  // 謝幕觸發：進入視窗即演出(無 POWER=純視覺)
  // 幕啟必須在台上:觀察燈列本體(threshold 1)——0.35 觀察整節時,觸發瞬間可見的
  // 幾乎全是 30vh 上留白,第一盞燈在台下就演掉了
  new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) runFinale(); }),
    { threshold: 1 }).observe(document.querySelector("#finale .lamps"));

  // ---- 訊號游標(K-62):附著/跟隨/讓位/脫離 ----
  const FINE = matchMedia("(pointer: fine)").matches;
  let sig = null, sigOn = false, sigX = 0, sigY = 0, tX = 0, tY = 0, sigRaf = null, ptrSeen = false;
  let trailTick = 0;
  function sigLoop(){
    if (!sigOn || !sig) return; // 脫離瞬間仍有一幀已排入佇列(實測抓到的競態)
    const px = sigX, py = sigY;
    sigX += (tX - sigX) * .2; sigY += (tY - sigY) * .2;
    sig.style.transform = "translate(" + sigX + "px," + sigY + "px)";
    // 拖尾(回饋2):速度感應的彗尾——靜止無痕,快移才留殘點;與開場飛行尾跡同語彙
    if (Math.hypot(sigX - px, sigY - py) > 5 && (++trailTick & 1) === 0 && !sig.classList.contains("hidden")){
      const t = document.createElement("span");
      t.className = "sig-trail";
      document.body.appendChild(t);
      t.animate([
        { transform: "translate(" + sigX + "px," + sigY + "px) scale(1)", opacity: .5 },
        { transform: "translate(" + sigX + "px," + sigY + "px) scale(.25)", opacity: 0 }
      ], { duration: 380, easing: "ease-out", fill: "both" }).onfinish = () => t.remove();
    }
    sigRaf = sigOn ? requestAnimationFrame(sigLoop) : null;
  }
  function attachSignal(x, y){
    if (!FINE || reduceMotion || sigOn) return;
    try { sessionStorage.setItem("sig", "1"); } catch {} // 跨頁旗標:dossier 內頁據此接手(回饋1)
    sigOn = true;
    sig = document.createElement("span");
    sig.className = "sig-cursor";
    sigX = x; sigY = y; tX = ptrSeen ? tX : x; tY = ptrSeen ? tY : y;
    sig.style.transform = "translate(" + x + "px," + y + "px)";
