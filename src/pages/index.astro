---
import "../styles/global.css";
import TransportNav from "../components/TransportNav.astro";
import HeroPanel from "../components/HeroPanel.astro";
import SignalPath from "../components/SignalPath.astro";
import Rack from "../components/Rack.astro";
import ControlRoom from "../components/ControlRoom.astro";
import Provenance from "../components/Provenance.astro";
import OutputBus from "../components/OutputBus.astro";
---

<html lang="zh-Hant-TW">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#070503" /><!-- 外框/瀏覽器鑲邊偏暗(視口外的白不是頁面塗得到的) -->
    <meta name="robots" content="noindex" /><!-- 預覽期防搜尋引擎收錄;正式切換時移除,同批補 canonical+OG+sitemap [R3 K-40] -->
    <title>如願 — 聲音 × 智能應用</title>
    <meta
      name="description"
      content="如願的作品集:聲音互動、AI 協作與混合多聲道監聽研究。"
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=Noto+Sans+TC:wght@400;500;700;900&display=swap" />
  </head>
  <body>
    <div class="chassis">
      <TransportNav />
      <div class="inner">
        <HeroPanel />
        <SignalPath />
        <Rack />
        <ControlRoom />
        <Provenance />
      </div>
      <OutputBus />
    </div>
  </body>
</html>
