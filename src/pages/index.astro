  document.querySelectorAll('a[href^="#"]').forEach((a) => {
    const id = a.getAttribute("href").slice(1);
    if (!id || a.id === "loopBtn") return; // loopBtn 有自己的重置流程
    a.addEventListener("click", (e) => {
      const t = document.getElementById(id);
      if (!t) return;
      e.preventDefault();
      const inner = t.querySelector(".beat-inner") || t;
      const block = inner.getBoundingClientRect().height < innerHeight * 0.8 ? "center" : "start";
      inner.scrollIntoView({ block, behavior: reduceMotion ? "auto" : "smooth" });
      history.pushState(null, "", "#" + id);
    });
  });

  // 全站音量(0–100 → master gain 0–0.2;預設 60=保守初始值)
  $("masterVol").addEventListener("input", (e) => {
    if (master) master.gain.setTargetAtTime(0.2 * (e.target.value / 100), ctx.currentTime, 0.05);
    try { sessionStorage.setItem("pwrvol", e.target.value); } catch {}
  });

  // 控制室：閘門列輕確認聲(乾；節流抗煩躁)
  let lastTick = 0;
