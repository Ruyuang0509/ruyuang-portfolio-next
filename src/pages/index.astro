    padToggle.textContent = on ? (padOn ? "■ 靜音" : "▶ 發聲") : "▶ 發聲(上方 PWR 開機)";
    modeNote.textContent = on ? "聲音開了。滑到頁面頂端展開控制列" + String.fromCharCode(0xFF0C) + "可調音量或關機。"
                              : "現在是安靜閱讀——內容一樣完整。";
