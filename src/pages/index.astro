// 訊號的旅程 —— 站台首頁。K-35 遷移:原型(docs/design/journey-proto-1.html,已凍結為歷史紀錄)
// 的三個區塊搬進 src/,引擎自此只有一份。R1 主控台頁與 console-audio.js 同批退場(K-36)。
import "../styles/journey.css";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const canonical = new URL(Astro.url.pathname.replace(/\/?$/, "/"), Astro.site).href;
const title = "如願 — 訊號的旅程";
const description = "一趟可以聽見的作品旅程:聲音互動、AI 協作與混合多聲道監聽研究。每一站都附得上證據。";
---

<html lang="zh-Hant-TW" data-base={base}><!-- data-base:is:inline 引擎不經 Astro 處理,資產路徑由此取得 -->
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#070503" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={title} />
    <meta property="og:locale" content="zh_TW" />
    <link rel="icon" href={base + "/favicon.svg"} type="image/svg+xml" />
    <link rel="icon" href={base + "/favicon-32.png"} type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href={base + "/apple-touch-icon.png"} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=Noto+Sans+TC:wght@400;500;700;900&display=swap" rel="stylesheet" />
  </head>
  <body>

<nav class="transport collapsed" id="transportNav" aria-label="站點跳轉(隨時可離隊)">
  <a href="#hook">開場</a><a href="#identity">身分</a><a href="#station">互動站</a><a href="#cinema">影院站</a><a href="#field">田野站</a><a href="#ctrl">控制室</a><a href="#master">OUT</a><a href="#exit">出口</a><!-- 回饋4:站點名稱;作品名歸 beat2 站內地圖 -->
  <button class="tpwr" id="powerBtn" aria-pressed="false" aria-label="開機——完整體驗(含聲音)">▶ PWR</button>
  <label class="tvol">VOL <input type="range" id="masterVol" min="0" max="100" value="60" disabled aria-label="全站音量" /></label>
</nav>
<button class="tfold" id="navFold" aria-expanded="false" aria-controls="transportNav" aria-label="展開導覽列">▾</button>
<div class="nav-hotzone" aria-hidden="true"></div><!-- 滑鼠移頂自動展開(回饋3) -->

<div class="filament" aria-hidden="true"></div>
<div class="line-rail" aria-hidden="true"><div class="line-breath"></div><div class="line-glow" id="lineGlow"></div></div>

<!-- 開機閘：載入儀式(JS+動效才啟用；跳過/Esc/直接捲動皆可離開，基態永不被擋) -->
<div class="gate" id="gate" role="dialog" aria-label="開機序列" tabindex="-1" hidden>
  <div class="gate-curtain gc-top" aria-hidden="true"></div>
  <div class="gate-curtain gc-bottom" aria-hidden="true"></div>
  <div class="gate-core">
    <span class="dot" aria-hidden="true"></span>
    <pre class="gate-lines" id="gateLines" aria-hidden="true"></pre>
    <div class="gate-meter" aria-hidden="true"><i id="gateFill"></i></div>
    <p class="gate-ear"><svg class="ear-ic" viewBox="0 0 24 24" width="15" height="15" aria-hidden="true"><path d="M4 14a8 8 0 0 1 16 0" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><rect x="3" y="13.5" width="4.4" height="7" rx="1.8" fill="currentColor"/><rect x="16.6" y="13.5" width="4.4" height="7" rx="1.8" fill="currentColor"/></svg>戴上耳機，聲音的方位與遠近會更清楚</p><!-- 回饋5+圖樣 -->
    <div class="gate-choice" id="gateChoice">
      <button class="cta" id="gateFull">▶ 開機・完整體驗(含聲音)</button>
      <button class="ghost" id="gateLite">安靜地往下讀</button>
    </div>
  </div>
  <button class="gate-skip" id="gateSkip">跳過 esc</button><!-- 錨定 .gate 角落;放 core 內會跟著 core 入棧改錨點(使用者回報的擠壓) -->
</div>

<!-- BEAT 1 · HOOK — base state is fully readable; 完整體驗 is an invitation, never a gate -->
<section class="beat" id="hook">
  <div class="wrap beat-inner">
    <p class="orient">MONITOR ROOM · 一場訊號的旅程</p>
    <p style="margin-top:var(--space-xl)"><span class="dot" id="hookDot" aria-hidden="true"></span></p>
    <h1>把聲學的理解門檻，<br />調到<em>人人可聽見</em>。</h1>
    <p class="hook-sub">這台監聽台可以親自動手：所有聲音，都與你息息相關。</p><!-- 使用者 2026-08-16 文藝向定稿句 -->
    <p class="scroll-hint" id="modeNote">現在是安靜閱讀——內容一樣完整。</p>
  </div>
</section>

<!-- BEAT 2 · IDENTITY -->
<section class="beat" id="identity">
  <div class="wrap beat-inner">
    <p class="orient">SIGNAL · 01 — 我是誰</p>
    <h2>用視覺與互動，降低聲學的理解門檻</h2>
    <p style="margin-top:var(--space-md)">一副監聽耳機，把我從數位學習設計帶進聲音。和朋友比較設備聽感時，我們聽得出差異，卻說不清楚這差異是來自頻率、空間，還是動態。</p>
    <p style="margin-top:var(--space-md)">我是把「說不清楚」當成題目的人——讀數位學習設計出身，自學 Pure Data 與訊號處理，正往聽覺感知與聲音應用走。我想做的一直是同一件事：把聽覺經驗，變成可以動手操作的東西。</p>
    <div class="readouts">
      <span>FOCUS <b>聲響 × 人工智慧</b></span>
      <span>ROUTE <b>作品 → 證據 → 研究</b></span>
      <span>OUT <b>混合多聲道監聽</b></span>
    </div>
    <!-- 甲-6 語意換位(回饋4):地圖不再充當目錄,而是身分主張的證據列——快讀承載主體改由 transport 作品名(首屏常駐)擔任 -->
    <p class="map-lead">接下來的三站，是這件事做到哪裡的證據：</p>
    <nav class="sitemap" aria-label="站內地圖：三件作品與去處">
      <a href="#station"><b>XY 互動板</b><span>Pure Data 即時訊號處理・可親自動手</span></a>
      <a href="#cinema"><b>Hamlet Story MV</b><span>AI 協作影音實驗・權利鏈可查</span></a>
      <a href="#field"><b>田野導覽影片</b><span>四部外拍後製・9 分 29 秒</span></a>
      <a href="#ctrl"><b>控制室</b><span>方法與證據</span></a>
      <a href="#gen"><b>作品集網站(兩代)</b><span>初代線上・二代重製</span></a>
      <a href="#master"><b>MASTER OUT</b><span>研究方向</span></a>
    </nav>
  </div>
</section>

<!-- BEAT 3 · STATION 1 (interactive) -->
<section class="beat" id="station">
  <div class="wrap beat-inner">
    <p class="orient">STATION · CH 01 — 互動站</p>
    <div class="panel">
      <span class="plate">XY PAD · 跨模態映射</span>
      <h2>透過本面板，我希望你仔細聆聽，感受聲音與空間的關係</h2><!-- 使用者 2026-08-16 文藝向定稿句 -->
      <p class="desc">原作是一塊 Pure Data 原型：位置進來，聲音出去——先靠 AI 協作搭起來，再逆向拆解訊號路徑，拆到能自己說明、自己改。你眼前這塊，是它的 Web Audio 重現：同一套映射，直接在瀏覽器裡發聲。</p>
      <div class="pad-wrap">
        <div class="xy-pad" id="xyPad" role="application" aria-label="XY 合成板：發聲後，橫軸控制聲像與音高，縱軸控制遠近">
          <span class="xy-dot" id="xyDot" aria-hidden="true"></span>
        </div>
        <div class="pad-legend"><span>← 左(低音・聲像左)</span><span>上=遠 / 下=近</span><span>右(高音・聲像右)→</span></div>
        <div class="pad-controls">
          <button class="play-toggle" id="padToggle" aria-pressed="false" disabled>▶ 發聲(上方 PWR 開機)</button>
          <label class="vol">音量 <input type="range" id="padVol" min="0" max="100" value="60" /></label>
          <span class="mono" style="font-size:var(--text-xs);color:var(--color-muted)">五聲音階 · 無錯音</span>
        </div>
      </div>
      <p class="note">設計註記：以軟起音與 limiter 壓住爆音。</p>
      <p class="dossier-link">深入這件作品:<a href={base + "/work/pd-crossmodal/"}>作品檔案(dossier)→</a></p>
    </div>
    <!-- 可發現的實驗:precedence effect(規格出自庫內空間聽覺研究) -->
    <div class="panel haas">
      <span class="plate">EXP · 先到者定位</span>
      <h3>先到的聲音，決定你聽到的方向</h3>
      <p class="desc" style="color:var(--color-ink-2);font-size:var(--text-sm);max-width:52ch">同一個聲音左右各放一次，拉開兩者的時間差，聽方向怎麼變。</p>
      <div class="haas-controls">
        <button class="play-toggle" id="haasBtn" disabled>▶ 播放(上方 PWR 開機)</button>
        <label class="vol">時間差 <input type="range" id="haasDelay" min="0" max="80" value="12" /> <span class="mono" id="haasMs">12 ms</span></label>
        <span class="haas-read" id="haasRead">融合：方向跟著先到的左邊</span>
      </div>
      <p class="note">設計註記：<b>≤1ms 疊加、約 2–50ms 融合、>50ms 拆成回聲</b>。</p>
    </div>
  </div>
</section>

<!-- BEAT 4 · STATION 2 (cinema) — 房間身分：廳堂；情緒：莊重 -->
<section class="beat" id="cinema" data-scene="cinema">
  <div class="wrap beat-inner">
    <p class="orient">STATION · CH 02 — 影院站</p>
    <div class="panel" style="border:0;background:transparent;padding:0">
      <h2 style="font-weight:700;font-size:1.2rem">Hamlet Story MV</h2>
      <p class="desc" style="color:var(--color-ink-2);font-size:var(--text-sm);max-width:52ch;margin-top:var(--space-sm)">AI 生成場景與配樂、本人剪輯整合的文學影音實驗——四十秒、八幕、雙語字幕，權利鏈完整可查。</p>
      <div class="cinema-frame">
        <div class="lb" aria-hidden="true"></div>
        <img src={base + "/media/hamlet-story-mv-poster-1200.webp"} alt="Hamlet Story MV 劇照——完整影片與雙語字幕在作品檔案裡" loading="lazy" /><!-- 資產一律走 base(check:links 會擋落在部署根之外的路徑) -->
        <div class="lb" aria-hidden="true"></div>
      </div>
      <p class="mono credit">Song: Blinds-Soft Lament — Suno 生成 · 00:00–00:40 · 非營利用途經 Suno 書面確認</p>
      <p class="desc" style="color:var(--color-ink-2);font-size:var(--text-sm);max-width:52ch;margin-top:var(--space-md)">誠實揭露一項規格差異：原提示要求純音樂，實際輸出含英語歌詞與人聲——公開版本以實際成片為準，呈現差異而非抹除。</p>
      <p class="note">設計註記：這一站的底色壓到全站最暗，黑邊收攏視線。</p>
      <p class="dossier-link">深入這件作品:<a href={base + "/work/hamlet-story-mv/"}>作品檔案(dossier)→</a></p>
    </div>
  </div>
</section>

<!-- BEAT 5 · STATION 3 (field) — 房間身分：開放空間；情緒：開放自然 -->
<section class="beat" id="field" data-scene="field">
  <div class="airgrid" aria-hidden="true"></div>
  <div class="horizon" aria-hidden="true"></div>
  <div class="wrap beat-inner">
    <p class="orient">STATION · CH 03 — 田野站</p>
    <h2 style="font-weight:700;font-size:1.2rem">導覽影片(四部)</h2>
    <p class="desc" style="color:var(--color-ink-2);font-size:var(--text-sm);max-width:52ch;margin-top:var(--space-sm)">地方文化見習的影音成品——潭墘、糖廠(上/下)、蒜頭老街，四部合計 9 分 29 秒；分鏡、外拍、剪輯與後製訊號處理、跨裝置播放驗證。</p>
    <p class="desc" style="color:var(--color-ink-2);font-size:var(--text-sm);max-width:52ch;margin-top:var(--space-md)">見習為雙人同梯；此處列出的，是工作日誌記載由本人負責的影音線。</p>
    <p class="note">設計註記：背景不設格線，只留一條地平線——這一站的影片，拍在沒有牆的地方。</p>
    <p class="dossier-link">深入這件作品:<a href={base + "/work/guide-videos/"}>作品檔案(dossier)→</a></p>
  </div>
</section>

<!-- 真休息(K-32):三站之後、後台之前的一段空白。零文字、零 CTA、無聲音場景——
     博物館座椅的網頁版：讓 rail 獨自呼吸，不是留白失誤。刻意不掛 data-scene(不成為音場)。 -->
<div class="rest" aria-hidden="true"><span class="rest-horizon"></span></div>

<!-- BEAT 6 · BACKSTAGE (control room) — 房間身分：控制室(乾);情緒：機能精確 -->
<section class="beat" id="ctrl" data-scene="ctrl">
  <div class="wrap beat-inner">
    <p class="orient">BACKSTAGE — 控制室</p>
    <div class="panel">
      <span class="plate">CONTROL ROOM · METHOD</span>
      <h2 style="font-weight:700;font-size:1.2rem">方法不必相信，可以檢查</h2>
      <p class="desc" style="color:var(--color-ink-2);font-size:var(--text-sm);max-width:52ch;margin-top:var(--space-sm)">每一格都掛著可查核的實據。發布前的機器強制檢查——核准永遠是人，閘門只是不讓遺忘發生。你看到的本頁，就是通過全部閘門後的部署產物:</p>
      <ul class="gatelist">
        <li><span class="led" aria-hidden="true"></span> check:paths — 本機路徑不外洩</li>
        <li><span class="led" aria-hidden="true"></span> check:media — 受限媒體與 GPS EXIF</li>
        <li><span class="led" aria-hidden="true"></span> check:wording — 措辭紀律</li>
        <li><span class="led" aria-hidden="true"></span> check:motion — 禁自動播放 · 動效降級</li>
        <li><span class="led" aria-hidden="true"></span> check:approval — 核准 human-only</li>
        <li><span class="led" aria-hidden="true"></span> check:obligations — 授權義務落在頁面上</li>
        <li><span class="led" aria-hidden="true"></span> check:csspunct — CSS 碼內全形標點</li>
      </ul>
      <p class="note">設計註記：這一站的殘響全站最低，回饋聲又乾又短。</p>
      <p class="dossier-link">這套檢查，連同整個網站，原始碼都公開:<a href="https://github.com/ruyuang0509/ruyuang-portfolio-next">github.com/ruyuang0509/ruyuang-portfolio-next</a>。<!-- 甲-5 程式原始碼類目+回饋6 兩代經歷;完整版=K-35 把網站立為 dossier 條目 --></p>
    </div>
  </div>
</section>

<!-- BEAT 6.5 · GEN — 兩代機(使用者 2026-08-16 裁定:一代經驗價值高,獨立成站) -->
<section class="beat" id="gen">
  <div class="wrap beat-inner">
    <p class="orient">BACKSTAGE · GEN —— 兩代機</p>
    <div class="panel">
      <span class="plate">SITE · TWO GENERATIONS</span>
      <h2 style="font-weight:700;font-size:1.2rem">這台機器，自己也走過兩代</h2>
      <p class="desc" style="color:var(--color-ink-2);font-size:var(--text-sm);max-width:52ch;margin-top:var(--space-sm)">第一代作品集仍在線上，原樣保存，留作紀錄;你正在走的是第二代——由研究驅動重製，七道閘門把關，每一步修正都留在公開的 git 歷史裡。</p>
      <p class="dossier-link">初代網站：<a href="https://ruyuang0509.github.io/ruyuang-portfolio/">聲響、互動與數位學習作品集 →</a></p>
      <p class="dossier-link">深入這件作品：<a href={base + "/work/portfolio-site/"}>兩代的作品檔案(dossier)→</a></p>
    </div>
  </div>
</section>

<!-- BEAT 7 · MASTER OUT — payoff:與開頭光點呼應 -->
<section class="beat" id="master">
  <div class="wrap beat-inner">
    <p class="orient">MASTER OUT — 訊號送出</p>
    <p style="margin-top:var(--space-xl)"><span class="dot" aria-hidden="true"></span></p>
    <h2>混合多聲道監聽</h2>
    <p class="desc">開頭那顆訊號，走過三站，在這裡送出。它做的始終是同一件事：把聽覺經驗，變成可以動手的東西。我要帶進研究所的題目，就是讓多聲道監聽也走這條路——建置與理解的門檻，再低一點。</p>
    <p class="desc">方法你剛剛走過：機器守規則，核准的永遠是人。這套工作法，跟著題目一起進來。<!-- K-33 雙軸收束：兌現 FOCUS 兩讀數;d019=方法非題目;d020=一句指回，不擴展示 --></p>
  </div>
</section>

<!-- FINALE v2 — 謝幕:零內容承載,純光影(d003)。跳過鍵依使用者 2026-08-16 裁定移除:
     「刻意感太重」——謝幕在正常流、無 pin,自然捲動即離開,不需要按鈕宣告這件事。 -->
<section class="beat" id="finale" data-scene="finale" aria-label="謝幕(純光影,無內容)">
  <div class="f-stage" aria-hidden="true"></div>
  <div class="wrap beat-inner">
    <div class="lamps" aria-hidden="true">
      <span class="lamp"><i></i>CH·01</span>
      <span class="lamp"><i></i>CH·02</span>
      <span class="lamp"><i></i>CH·03</span>
      <span class="lamp"><i></i>MASTER</span>
    </div>
    <p class="colophon-quote">「先讓路途平坦，再思考如何裝飾風景」<span class="colophon-thanks">Thanks for watching.</span></p>
  </div>
</section>

