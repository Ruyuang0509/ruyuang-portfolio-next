      const ring = document.createElement("span");
      ring.style.cssText = "position:fixed;left:" + (hb.left + hb.width / 2) + "px;top:" + (hb.top + hb.height / 2) + "px;width:10px;height:10px;border-radius:50%;border:1px solid var(--color-accent);transform:translate(-50%,-50%);z-index:69;pointer-events:none";
      document.body.appendChild(ring);
