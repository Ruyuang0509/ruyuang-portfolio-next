  }
  function runGate(){
    if (reduceMotion) return; // 動效低敏模式：不演，直接可讀
    // 重演規則(使用者 2026-08-16,取代 session-once):重整=必演;
    // 唯「從站內內頁(dossier/research)回歸」不演。reload 判定優先——回歸後再重整仍算重整。
    const navType = (performance.getEntriesByType("navigation")[0] || {}).type || "navigate";
    if (navType !== "reload" && FROM_INNER){ ensureSignal(); return; } // 內頁回歸(連結或 Back 皆算):不重演,但訊號回到手上
    gateT0 = performance.now();
    try { sessionStorage.removeItem("pwr"); } catch {} // 批判B:閘門重問=舊答案作廢——Esc/跳過/捲動離場不得讓過期的「on」在下次回歸還魂
    gate.hidden = false; requestAnimationFrame(() => { if (gateDismissed) return; gate.classList.add("on"); gate.focus(); }); // [R3 K-09] focus 入閘;守衛防「解除後補 .on」殭屍態
    gate.addEventListener("keydown", (e) => { // [R3 K-09] APG dialog:Tab 圈內(只在可見鈕之間)
      if (e.key !== "Tab") return;
      const f = [...gate.querySelectorAll("button")].filter((b) => b.checkVisibility ? b.checkVisibility() : b.offsetParent !== null);
      if (!f.length) return;
      const first = f[0], last = f[f.length - 1];
      if (e.shiftKey && (document.activeElement === first || document.activeElement === gate)){ e.preventDefault(); last.focus(); }
      else if (!e.shiftKey && (document.activeElement === last || document.activeElement === gate)){ e.preventDefault(); first.focus(); }
    });
    const checks = [
      ["SIGNAL PATH", document.fonts ? document.fonts.ready : Promise.resolve()],
      ["MONITORS",    new Promise((res) => { const im = new Image(); im.onload = im.onerror = res;
                        im.src = document.documentElement.dataset.base + "/media/hamlet-story-mv-poster-1200.webp"; })],
      ["ROOM",        new Promise((res) => setTimeout(res, 700))],
    ];
    const box = $("gateLines"); let done = 0;
    checks.forEach(([label, ready], i) => {
      const row = document.createElement("div");
      row.textContent = label.padEnd(12, " ") + "……";
      box.appendChild(row);
      setTimeout(() => row.classList.add("show"), 250 + i * 350);
      Promise.race([ready, new Promise((res) => setTimeout(res, 2200))]).then(() => {
        row.innerHTML = label.padEnd(12, " ") + '<span class="ok">OK</span>';
        done++;
        $("gateFill").style.transform = "scaleX(" + (done / checks.length) + ")";
        if (done === checks.length)
          setTimeout(() => { if (gateDismissed) return; // [R3 K-09] 已解除的閘不得回頭偷焦點(背景分頁 rAF 節流下實測到)
            $("gateChoice").classList.add("show"); $("gateFull").focus(); }, 350);
      });
    });
    addEventListener("keydown", (e) => { if (e.key === "Escape") dismissGate(); });
    addEventListener("scroll", gateScrollDismiss, { passive: true });
    $("gateSkip").addEventListener("click", () => dismissGate());
    $("gateLite").addEventListener("click", () => { dismissGate("choice");
      try { sessionStorage.setItem("pwr", "off"); } catch {} }); // 安靜進站=明確選擇(回饋3)
    $("gateFull").addEventListener("click", () => { dismissGate("choice"); if (!powered) powerBtn.click(); });
  }
  let restorePending = false; // 批判A:恢復是「可取消的認領」,不是既成事實——PWR 按壓的當下就要贏過任何懸置 promise
  const FROM_INNER = (() => { // 批判E:歷史回退(Back)不更新 referrer——內頁寫麵包屑,回歸判定=referrer ∪ 麵包屑;讀後即銷
    let bc = null; try { bc = sessionStorage.getItem("inner"); sessionStorage.removeItem("inner"); } catch {}
    return /\/(work|research)\//.test(document.referrer) || bc === "1";
  })();
  function restorePowerFromSession(){ // 回饋3(2026-08-16):內頁回歸=延續音效選擇。reload 走閘門重問,不在此列
    const navType = (performance.getEntriesByType("navigation")[0] || {}).type || "navigate";
    if (navType === "reload" || !FROM_INNER) return;
    let st = null, v = null;
    try { st = sessionStorage.getItem("pwr"); v = sessionStorage.getItem("pwrvol"); } catch {}
    if (v !== null && +v >= 0 && +v <= 100) $("masterVol").value = v; // 批判C:音量先還原——關機回歸後再開機,也該用你選過的音量(d015 驚嚇軸)
    if (st !== "on") return; // off/未選擇:維持安靜,現狀即正解
    restorePending = true;
    const offGesture = () => {
      removeEventListener("pointerdown", onGesture); removeEventListener("pointerup", onGesture);
      removeEventListener("keydown", onGesture);
    };
    const tryOn = () => {
      if (!restorePending || powered) return;
      ensureCtx();
      ctx.resume().then(() => {
        if (!restorePending || powered || ctx.state !== "running") return; // 批判A:被取消的認領不得回頭開機(pointerdown 授權會喚醒懸置 promise)
        restorePending = false; offGesture();
        master.gain.setTargetAtTime(0.2 * ($("masterVol").value / 100), ctx.currentTime, 0.05);
        setPower(true); kick(); // 無 powerOnSound:回歸是延續,不是再開機(K-29 儀式只在閘)
      }).catch(() => {});
    };
    const onGesture = (e) => { // 批判D:非一次性——Esc 與觸控 pointerdown 不授權自動播放,一次性監聽會被它們白白吃掉
      if (powered || !restorePending){ offGesture(); return; }
      if (e.target && e.target.closest && e.target.closest("#powerBtn")){ restorePending = false; offGesture(); return; } // 讓位給按鈕語意=取消認領
      if (e.type === "keydown" && e.key === "Escape") return; // 非授權鍵:不消耗、不觸發
      tryOn(); // 成功才自我拆除(見 then);失敗留著等下一個手勢
    };
    tryOn(); // 政策放行的環境(已互動過的 origin 等)直接恢復
    addEventListener("pointerdown", onGesture);
    addEventListener("pointerup", onGesture); // 觸控在 pointerup 才取得授權
    addEventListener("keydown", onGesture);
  }
  restorePowerFromSession(); // reduced-motion 也適用:電源是狀態,不是儀式
  runGate();

  // ---- 捲動進度:CSS timeline 不可用時(Firefox / reduced-motion)由被動監聽直寫 ----
  // reduced-motion 也必須跑這條:K-30 讓 filament 成為唯一進度指示後，兩條路徑都關掉會使
  // 低敏使用者完全失去進度回饋(R2 回饋 3 未滿足)。直寫是「位置映射」不是動畫——無過渡、
  // 無插值，捲到哪畫到哪，正是 reduced-motion 該有的形狀。
  if (reduceMotion || !(window.CSS && CSS.supports("animation-timeline: scroll()"))){
    const fil = document.querySelector(".filament");
    let ticking = false;
    const upd = () => {
      ticking = false;
      const max = document.documentElement.scrollHeight - innerHeight;
      const p = max > 0 ? Math.min(1, scrollY / max) : 0;
      fil.style.transform = "scaleX(" + p + ")";
    };
    addEventListener("scroll", () => { if (!ticking){ ticking = true; requestAnimationFrame(upd); } }, { passive: true });
    upd();
  }
})();
    </script>
  </body>
</html>
