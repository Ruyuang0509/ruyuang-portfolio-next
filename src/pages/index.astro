      el.animate([{ opacity: 0, transform: "translateY(18px)" }, { opacity: 1, transform: "none" }],
        { duration: 520, delay: 140 + i * 90, easing: "cubic-bezier(.22,1,.36,1)", fill: "backwards" }));
  }
  function dismissGate(mode){ // mode="choice"=按鈕選擇(演轉場);其餘(捲動/Esc/跳過)=簡單淡出
    if (gateDismissed) return; gateDismissed = true;
    removeEventListener("scroll", gateScrollDismiss);
    if (mode === "choice" && !reduceMotion){
      flipDotToHook(); hookEntrance();
