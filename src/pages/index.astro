    ensureSignal(); // 附著為冪等:FLIP 已附著則無事;bail/秒滾也拿得到訊號(回饋2)
  }
  function focusPower(){ // 收合時聚焦「可見的把手」而非展開整列——預設收起是裁定,過閘不得偷偷展開(回饋2)
    const nav = document.querySelector(".transport");
