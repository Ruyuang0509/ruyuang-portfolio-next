    if (!powered){
      ensureCtx();
      if (ctx.state === "suspended") ctx.resume(); // 手勢內 resume(G1 驗證的可攜模式)
      master.gain.setTargetAtTime(0.2 * ($("masterVol").value / 100), ctx.currentTime, 0.05); // 回復關機前音量
      setPower(true);
      try { sessionStorage.setItem("pwr", "on"); } catch {} // 回饋3:選擇入 session,內頁回歸讀回
      // [R3 K-29] 儀式只存在開機閘一處;POWER 就地回應——右下提示依使用者裁定刪除(pad 圖例已在現場)
