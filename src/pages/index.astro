    <script is:inline>
// R2 audio engine v2 — 全部聲音 opt-in;安全鏈:voices → chGain → send(演算法殘響) → analyser → LIMITER → master
(() => {
  const reduceMotion = matchMedia("(prefers-reduced-motion: reduce)").matches;
  document.documentElement.classList.add("js"); // 增強層開關：無 JS=完整可讀基態(d018)
  const PENTA = [220, 261.63, 293.66, 329.63, 392, 440, 523.25];
  let ctx = null, master = null, limiter = null, analyser = null, buf = null;
  let outMeter = null, outBuf = null, samplePeak = 0;
  let padVoice = null, padOn = false, powered = false, rafId = null;
  let reverb = null, room = null, sceneVoices = null, lastRoom = "", finaleDone = false;

  // 房間身分(離散，場景邊界切換;d004):feedback / 低通 / send 濕度
  const ROOMS = {
    default:{ fb:.32, lp:2400, wet:.18 },   // 小房間(開機/身分/互動站)
    cinema: { fb:.46, lp:1600, wet:.30 },   // 廳堂：莊重
    field:  { fb:.24, lp:3200, wet:.22 },   // 開放空間：遠方感
    ctrl:   { fb:.10, lp:2000, wet:.04 },   // 控制室：乾
    finale: { fb:.55, lp:1900, wet:.36 },   // 全站最大空間感(LEV 峰值)
  };

  const $ = (id) => document.getElementById(id);
  const powerBtn = $("powerBtn"), padToggle = $("padToggle"),
        pad = $("xyPad"), dot = $("xyDot"), modeNote = $("modeNote");

  function ensureCtx(){
    if (ctx) return;
    ctx = new (window.AudioContext || window.webkitAudioContext)();
    // [R3 K-02] Round E 裁決:iPhone 靜音鍵下仍可發聲。Safari 16.4+ 實驗特性——feature-detect,不支援靜默略過
    try { if (navigator.audioSession) navigator.audioSession.type = "playback"; } catch {}
    // [R3 K-08] 聽力安全鏈:ratio=20 是 W3C 規格上限(min 1/max 20)——規格內最接近限幅的設定,
    // 定位=安全網，非真限幅器(真 brick-wall 需 WaveShaper/AudioWorklet,R3 減法清單：不做)。
    // 規格明載壓縮器有固定 look-ahead 延遲;analyser 維持在 limiter 前，視覺同步不受其影響。
    limiter = ctx.createDynamicsCompressor();
    limiter.threshold.value = -12; limiter.knee.value = 0; limiter.ratio.value = 20;
    limiter.attack.value = 0.003; limiter.release.value = 0.25;
    master = ctx.createGain(); master.gain.value = 0.12;
    analyser = ctx.createAnalyser(); analyser.fftSize = 256;
    buf = new Uint8Array(analyser.frequencyBinCount);
    analyser.connect(limiter); limiter.connect(master); master.connect(ctx.destination);
    // [R3 K-07] d015 誠實化：輸出峰值只能在 master 之後、用 float 時域樣本量(byte 頻譜原理上量不到峰值,
    // 僅供視覺律動)。量到的是 sample peak,非 true peak(無 4× 過取樣，密集素材可低估 1–3dB)——限制照實記。
    outMeter = ctx.createAnalyser(); outMeter.fftSize = 2048;
    outBuf = new Float32Array(outMeter.fftSize);
    master.connect(outMeter);
    // 演算法殘響(G1 決策：不用 IR 檔)——小房間身分：短延遲×2 + 回授 + 低通
    reverb = ctx.createGain(); reverb.gain.value = 0.18;
    const d1 = ctx.createDelay(); d1.delayTime.value = 0.031;
    const d2 = ctx.createDelay(); d2.delayTime.value = 0.047;
    const fb = ctx.createGain(); fb.gain.value = 0.32;
    const lp = ctx.createBiquadFilter(); lp.type = "lowpass"; lp.frequency.value = 2400;
    reverb.connect(d1); reverb.connect(d2); d1.connect(fb); d2.connect(fb);
    fb.connect(lp); lp.connect(d1); lp.connect(analyser);
    room = { fb, lp };
    sceneVoices = buildSceneVoices();
  }

  // 場景聲音身分(逐場景 voice;鄰近度連續驅動=「聲源」層，d004)
  function buildSceneVoices(){
    const v = {};
    { // 影院站:低音域小調傾向 pad(莊重)。抗煩躁三改(使用者 2026-08-16:長時間觀看產生煩躁)——
      // 靜態頻譜+淺呼吸=疲勞源;改為 (a) 呼吸加深到近靜默休止 (b) 音色極慢演化 (c) 基準增益調低
      const mix = ctx.createGain(); mix.gain.value = 1;
      [[110,"sine"],[130.81,"sine"],[164.81,"triangle"]].forEach(([f,t]) => {
        const o = ctx.createOscillator(); o.type = t;
        o.frequency.value = f * (1 + (Math.random() - .5) * .003);
        const og = ctx.createGain(); og.gain.value = .3;
        o.connect(og); og.connect(mix); o.start();
      });
      const lp = ctx.createBiquadFilter(); lp.type = "lowpass"; lp.frequency.value = 650; lp.Q.value = .5;
      const lfoF = ctx.createOscillator(); lfoF.frequency.value = .03; // 音色呼吸:約 33 秒一輪
      const lgF = ctx.createGain(); lgF.gain.value = 220;              // 掃 430–870Hz,頻譜不再靜止
      lfoF.connect(lgF); lgF.connect(lp.frequency); lfoF.start();
      const breath = ctx.createGain(); breath.gain.value = .5;
      const lfo = ctx.createOscillator(); lfo.frequency.value = .045;  // 約 22 秒一息
      const lg = ctx.createGain(); lg.gain.value = .42;                // 谷值≈.08=近靜默的休止,聲音「間歇性地活著」
      lfo.connect(lg); lg.connect(breath.gain); lfo.start();
      const g = ctx.createGain(); g.gain.value = 0;
      mix.connect(lp); lp.connect(breath); breath.connect(g);
      const send = ctx.createGain(); send.gain.value = .5;
      g.connect(analyser); g.connect(send); send.connect(reverb);
      v.cinema = { g, base:.10 };
    }
    { // 田野站：濾波噪音的遠方感(開放自然)——帶通中心慢速漂移
      const len = ctx.sampleRate * 2, nb = ctx.createBuffer(1, len, ctx.sampleRate), d = nb.getChannelData(0);
      for (let i = 0; i < len; i++) d[i] = Math.random() * 2 - 1;
      const src = ctx.createBufferSource(); src.buffer = nb; src.loop = true;
      const bp = ctx.createBiquadFilter(); bp.type = "bandpass"; bp.frequency.value = 520; bp.Q.value = .7;
      const lfo = ctx.createOscillator(); lfo.frequency.value = .05;
      const lg = ctx.createGain(); lg.gain.value = 160;
      lfo.connect(lg); lg.connect(bp.frequency); lfo.start();
      const g = ctx.createGain(); g.gain.value = 0;
      src.connect(bp); bp.connect(g);
      const send = ctx.createGain(); send.gain.value = .3;
      g.connect(analyser); g.connect(send); send.connect(reverb);
      src.start();
      v.field = { g, base:.09 };
    }
    return v;
  }

  // 鄰近度(viewport 中心距離)→ 場景 voice 增益；最近場景 → 房間身分離散切換
  const sceneEls = () => [...document.querySelectorAll("[data-scene]")];
  function updateScenes(){
    if (!powered || !sceneVoices) return;
    const vh = innerHeight; let nearest = "default", nearestD = Infinity;
    for (const el of sceneEls()){
      const r = el.getBoundingClientRect();
      const c = Math.abs(r.top + r.height / 2 - vh / 2);
      if (r.bottom > 0 && r.top < vh && c < nearestD){ nearestD = c; nearest = el.dataset.scene; }
      const key = el.dataset.scene, v = sceneVoices[key];
      if (v){
        const prox = Math.max(0, 1 - c / (vh * .85));
        v.g.gain.setTargetAtTime(v.base * prox * prox, ctx.currentTime, .12);
      }
    }
    if (nearest !== lastRoom){
      lastRoom = nearest;
      const R = ROOMS[nearest] || ROOMS.default;
      room.fb.gain.setTargetAtTime(R.fb, ctx.currentTime, .4);
      room.lp.frequency.setTargetAtTime(R.lp, ctx.currentTime, .4);
      if (nearest !== "default" || !padOn) // 互動站內 pad 的 Y 仍握有 send 濕度
        reverb.gain.setTargetAtTime(R.wet, ctx.currentTime, .4);
    }
  }

  function dryTick(){ // 控制室輕確認聲：乾、短、微隨機(抗煩躁)
    if (!powered || !ctx) return;
    const o = ctx.createOscillator(), g = ctx.createGain();
    o.type = "sine"; o.frequency.value = 1320 * (1 + (Math.random() - .5) * .05);
    g.gain.setValueAtTime(0, ctx.currentTime);
    g.gain.linearRampToValueAtTime(.09, ctx.currentTime + .008);
    g.gain.exponentialRampToValueAtTime(.001, ctx.currentTime + .09);
    o.connect(g); g.connect(analyser); o.start(); o.stop(ctx.currentTime + .1);
  }

  function finaleChord(){ // 終止和弦：五聲內、長衰減入靜默(敬畏→釋放);全部經 limiter
    [220, 261.63, 329.63, 440].forEach((f, i) => {
      const o = ctx.createOscillator(); o.type = i < 2 ? "sine" : "triangle"; o.frequency.value = f;
      const g = ctx.createGain(); g.gain.setValueAtTime(0, ctx.currentTime);
      g.gain.linearRampToValueAtTime(.2 / (i + 1) + .05, ctx.currentTime + .9 + i * .12); // 淡入(零驚嚇)
      g.gain.exponentialRampToValueAtTime(.0001, ctx.currentTime + 7);
      o.connect(g); g.connect(reverb); g.connect(analyser);
      o.start(ctx.currentTime + i * .12); o.stop(ctx.currentTime + 7.2);
    });
  }

  function ringPulse(lamp){ // 燈點亮的擴散環(WAAPI,自清)
    const r = document.createElement("span"); r.className = "f-ring";
    lamp.appendChild(r);
    r.animate([
      { opacity:.9, transform:"translate(-50%,-50%) scale(1)" },
      { opacity:0,  transform:"translate(-50%,-50%) scale(7)" }
    ], { duration:900, easing:"cubic-bezier(.22,1,.36,1)" }).onfinish = () => r.remove();
  }
  function burst(fin){ // 主爆發:中央光點綻開+琥珀粒子場+全屏暖洗+燈列回聲環+進度絲增輝
    const stage = fin.querySelector(".f-stage");
    // 全屏暖洗:低不透明慢脈衝(1.6s,峰值 14% 琥珀)——力度來自範圍,不來自亮度(零驚嚇)
    const wash = document.createElement("span");
    wash.style.cssText = "position:fixed;inset:0;z-index:2;pointer-events:none;background:radial-gradient(60% 50% at 50% 55%, color-mix(in oklab, var(--color-accent) 14%, transparent), transparent 70%)";
    document.body.appendChild(wash);
    wash.animate([{ opacity: 0 }, { opacity: 1, offset: .35 }, { opacity: 0 }],
      { duration: 1600, easing: "ease-out" }).onfinish = () => wash.remove();
    // 燈列回聲環:主爆發時四盞燈再各盪一圈(60ms 錯拍)
    [...fin.querySelectorAll(".lamp")].forEach((l, i) => setTimeout(() => ringPulse(l), i * 60));
    // 進度絲增輝:滿格的磁帶計數器閃一下
    const fil = document.querySelector(".filament");
    if (fil) fil.animate([{ filter: "brightness(1)" }, { filter: "brightness(2.4)" }, { filter: "brightness(1)" }],
      { duration: 1200, easing: "ease-out" });
    const core = document.createElement("span"); core.className = "f-core";
    stage.appendChild(core);
    core.animate([
      { opacity:0, boxShadow:"0 0 0 0 transparent", transform:"translate(-50%,-50%) scale(.4)" },
      { opacity:1, boxShadow:"0 0 90px 30px color-mix(in oklab, var(--color-accent) 55%, transparent)", transform:"translate(-50%,-50%) scale(1)", offset:.35 },
      { opacity:0, boxShadow:"0 0 140px 10px transparent", transform:"translate(-50%,-50%) scale(1.6)" }
    ], { duration:2200, easing:"cubic-bezier(.22,1,.36,1)" }).onfinish = () => core.remove();
    // 數位訊號煙火(使用者令):物理=煙火(初速散開→頂點→垂降+殘餘橫移);
    // 視覺=數位訊號(方形位元+短劃線,零圓角,步進式閃爍=取樣感)
    for (let i = 0; i < 46; i++){
      const sp = document.createElement("span"); sp.className = "f-spark";
      const dash = Math.random() < .38;
      const w = dash ? 7 + Math.random() * 4 : 2 + Math.random() * 3;
      sp.style.width = w + "px"; sp.style.height = (dash ? 2 : w) + "px";
      sp.style.borderRadius = "0";
      if (Math.random() < .25) sp.style.background = "var(--color-focus)";
      const ang = Math.random() * Math.PI * 2;
      const v = 70 + Math.random() * 190;
      const ax = Math.cos(ang) * v, ay = Math.sin(ang) * v * .75 - 30;
      const fall = 110 + Math.random() * 170, drift = ax * (.12 + Math.random() * .18);
      const rot = Math.random() * 160 - 80;
      const dur = 1500 + Math.random() * 800, dly = Math.random() * 220;
      stage.appendChild(sp);
      sp.animate([
        { transform: "translate(-50%,-50%) rotate(0deg)", easing: "cubic-bezier(.16,.84,.44,1)" },
        { transform: "translate(calc(-50% + " + ax + "px), calc(-50% + " + ay + "px)) rotate(" + rot + "deg)", offset: .42, easing: "cubic-bezier(.55,.06,.68,.19)" },
        { transform: "translate(calc(-50% + " + (ax + drift) + "px), calc(-50% + " + (ay + fall) + "px)) rotate(" + (rot * 1.6) + "deg)" }
      ], { duration: dur, delay: dly, fill: "both" });
      sp.animate([
        { opacity: 0 }, { opacity: 1, offset: .08 }, { opacity: .35, offset: .5 },
        { opacity: .85, offset: .64 }, { opacity: 0 }
      ], { duration: dur, delay: dly, easing: "steps(5, jump-none)", fill: "both" }).onfinish = () => sp.remove();
    }
  }
  function glowSurge(dur){ // 未開機的光湧:手動推 --glow 再放掉。開機時不走這裡——
    // 和弦經 analyser 驅動同一組光,才是「同源」;兩套並跑=假動作(R2 同源法)
    dur = dur || 5000; // 謝幕=5s(長衰減入靜默);開場落地=1.6s(短亮一下,預告有光)
    const t0 = performance.now();
    (function step(now){
      const p = Math.min(1, (now - t0) / dur);
      const v = p < .13 ? p / .13 : Math.pow(1 - (p - .13) / .87, 2.5); // 峰後指數型衰減,非線性掐斷
      document.documentElement.style.setProperty("--glow", (v * .9).toFixed(3));
      if (p < 1) requestAnimationFrame(step);
      else document.documentElement.style.setProperty("--glow", "0");
    })(performance.now());
  }
  let showEscaped = false; // Esc 逃出演出時,連自動滾動也一併取消
  function lockScroll(ms){ // d005 修訂(使用者 2026-08-16):唯謝幕演出期間鎖捲動,保演出完整;Esc 隨時解鎖
    const stop = (e) => e.preventDefault();
    const keys = ["ArrowDown", "ArrowUp", "PageDown", "PageUp", "Home", "End", " "];
    const keyStop = (e) => { if (keys.includes(e.key)) e.preventDefault(); };
    const release = () => {
      removeEventListener("wheel", stop); removeEventListener("touchmove", stop);
      removeEventListener("keydown", keyStop); removeEventListener("keydown", escRel);
    };
    const escRel = (e) => { if (e.key === "Escape"){ showEscaped = true; release(); } };
    addEventListener("wheel", stop, { passive: false });
    addEventListener("touchmove", stop, { passive: false });
    addEventListener("keydown", keyStop);
    addEventListener("keydown", escRel);
    setTimeout(release, ms);
  }
  let rewinding = false; // 倒帶途中穿越謝幕不得開演:幽靈和弦+把第二輪的謝幕燒掉(批判實證)
  function runFinale(){ // 謝幕 v2:燈序→環→主爆發(+和弦同拍)→字卡。仍零內容(d003);未開機=純視覺(d002)
    if (finaleDone || rewinding) return; finaleDone = true;
    const fin = $("finale");
    const lamps = [...fin.querySelectorAll(".lamp")];
    if (reduceMotion){
      document.documentElement.classList.add("rail-off");
      lamps.forEach((l) => l.classList.add("on"));
      fin.classList.add("run");
      if (powered && ctx){ finaleChord(); kick(); }
      return;
    }
    showEscaped = false;
    lockScroll(8300); // 演出+自動滾出口全程落鎖(d005 修訂追加);Esc 隨時逃出
    fin.scrollIntoView({ block: "center", behavior: "smooth" }); // 追加令:演出自動置中
    setTimeout(() => { // 追加令:演出完畢(字卡讀完一拍)自動滾至出口;Esc 逃出者不強送
      if (showEscaped) return;
      const exitInner = document.querySelector("#exit .beat-inner") || document.getElementById("exit");
      exitInner.scrollIntoView({ block: "center", behavior: "smooth" });
    }, 7400);
    document.documentElement.classList.add("rail-off"); // 訊號送出,線退場(回饋3)
    // K-62 脫離:等自動置中落定(700ms;鎖定期內座標不再變)才起飛——
    // 置中滾動進行中就用舊座標,會飛向「舞台曾在的位置」(邊緣),再在實際位置爆炸=瞬移(使用者實證)
    setTimeout(() => {
      const carried = detachSignal();
      if (!carried) return;
      const fr = fin.getBoundingClientRect(); // 置中後的新鮮座標
      const destX = fr.left + fr.width / 2, destY = fr.top + fr.height * .44;
      carried.el.animate([
        { transform: "translate(" + carried.x + "px," + carried.y + "px) scale(1)" },
        { transform: "translate(" + destX + "px," + destY + "px) scale(1.3)" }
      ], { duration: 900, easing: "cubic-bezier(.22,1,.36,1)", fill: "forwards" });
      setTimeout(() => carried.el.remove(), 1500); // t=2200 主爆發同拍:core 同點綻放,訊號完成迴路
    }, 700);
    lamps.forEach((l, i) => setTimeout(() => { l.classList.add("on"); ringPulse(l); }, 420 * i));
    setTimeout(() => { // 主爆發在末環(2160ms)收完之後——注意力單焦點,環不與爆發同臺
      burst(fin);
      if (powered && ctx){ finaleChord(); kick(); } else { glowSurge(); }
    }, 2200);
    // 字卡=釋放拍:等爆發收束、粒子自清(~4450ms)之後,從靜默裡浮現——敬畏與釋放是兩拍,不同臺
    setTimeout(() => fin.classList.add("run"), 4600);
  }

  function softBlip(){ // UI 回饋：軟起音+微隨機失諧(抗煩躁)
    if (!powered || !ctx) return;
    const o = ctx.createOscillator(), g = ctx.createGain();
    o.type = "sine"; o.frequency.value = 660 * (1 + (Math.random() - .5) * 0.04);
    g.gain.setValueAtTime(0, ctx.currentTime);
    g.gain.linearRampToValueAtTime(0.25, ctx.currentTime + 0.02);
    g.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 0.28);
    o.connect(g); g.connect(analyser); o.start(); o.stop(ctx.currentTime + 0.3);
  }

  function powerOnSound(){ // 開機聲：暖正弦緩慢綻開+微上滑(情緒軌：甦醒；零驚嚇=長淡入)
    const o = ctx.createOscillator(), g = ctx.createGain();
    o.type = "sine";
    o.frequency.setValueAtTime(180, ctx.currentTime);
    o.frequency.exponentialRampToValueAtTime(220, ctx.currentTime + 1.4);
    g.gain.setValueAtTime(0, ctx.currentTime);
    g.gain.linearRampToValueAtTime(0.5, ctx.currentTime + 1.1);
    g.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 2.4);
    o.connect(g); g.connect(reverb); g.connect(analyser);
    o.start(); o.stop(ctx.currentTime + 2.5);
  }

  function buildPadVoice(){
    const o1 = ctx.createOscillator(); o1.type = "sine"; o1.frequency.value = PENTA[2];
    const o2 = ctx.createOscillator(); o2.type = "triangle"; o2.frequency.value = PENTA[2] * 2.003;
    const f = ctx.createBiquadFilter(); f.type = "lowpass"; f.frequency.value = 1400; f.Q.value = 3;
    const panN = ctx.createStereoPanner(); // 空間映射契約:X=聲像
    const g = ctx.createGain(); g.gain.value = 0;
    o1.connect(f); o2.connect(f); f.connect(panN); panN.connect(g);
    g.connect(analyser); g.connect(reverb);
    o1.start(); o2.start();
    g.gain.linearRampToValueAtTime(0.5 * ($("padVol").value / 100), ctx.currentTime + 0.35); // 軟起音
    return { o1, o2, f, panN, g, stop(){
      g.gain.linearRampToValueAtTime(0, ctx.currentTime + 0.25); // 軟收
      setTimeout(() => { try { o1.stop(); o2.stop(); } catch {} }, 400);
    }};
  }

  function meterLoop(){
    updateScenes(); // 鄰近度→場景 voice/房間身分(僅完整體驗模式)
    analyser.getByteFrequencyData(buf);
    let s = 0; for (let i = 0; i < buf.length; i++) s += buf[i];
    const lvl = Math.min(1, (s / buf.length) / 120);
    document.documentElement.style.setProperty("--glow", lvl.toFixed(3)); // 視聽同源:analyser→光暈
    outMeter.getFloatTimeDomainData(outBuf); // [R3 K-07] 不 clamp:down-mix 時 |x|>1.0 合法，夾住會低報削波
    for (let i = 0; i < outBuf.length; i++){ const a = Math.abs(outBuf[i]); if (a > samplePeak) samplePeak = a; }
    document.documentElement.dataset.peak = samplePeak.toFixed(3);
    rafId = powered ? requestAnimationFrame(meterLoop) : null;
    if (rafId === null) document.documentElement.style.setProperty("--glow", "0");
  }
  const kick = () => { if (rafId == null) rafId = requestAnimationFrame(meterLoop); };

  function setPower(on){
    powered = on;
    powerBtn.setAttribute("aria-pressed", String(on));
    powerBtn.textContent = on ? "■ PWR" : "▶ PWR"; // 回饋2:入站已在閘選過,hook 不再重問;PWR 移入導覽列
    powerBtn.setAttribute("aria-label", on ? "關機——回到安靜" : "開機——完整體驗(含聲音)");
