    } else {
      if (padVoice){ padVoice.stop(); padVoice = null; padOn = false; }
      padToggle.setAttribute("aria-pressed", "false"); // 批判 F7:關機後殘留 true
      setPower(false);
      try { sessionStorage.setItem("pwr", "off"); } catch {} // 親手關機=明確選擇
      // [R3 K-04] 關機不咔嗒：零驚嚇是對稱的——先 150ms 淡出，靜了再 suspend(原本 suspend() 硬切)
      if (ctx){
        master.gain.setTargetAtTime(0, ctx.currentTime, 0.05);
        setTimeout(() => { if (!powered && ctx.state === "running") ctx.suspend(); }, 300);
      }
    }
  });

  // [R3 K-05] 回到開頭=可以真的再走一次：重置謝幕狀態(原本 finaleDone 永不重置，第二輪走到底沒有謝幕);
  // reduced-motion 瞬移，否則平滑倒帶
  $("loopBtn").addEventListener("click", (e) => {
    e.preventDefault();
    rewinding = true; // finaleDone 等倒帶結束才解鎖——立刻解鎖會在穿越謝幕時被幽靈觸發吃掉
    const fin = $("finale");
    fin.classList.remove("run");
    fin.querySelectorAll(".lamp").forEach((l) => l.classList.remove("on"));
    document.documentElement.classList.remove("rail-off"); // 線回到路上,旅程重新成立
    const done = () => { if (!rewinding) return; rewinding = false; finaleDone = false;
      if (ptrSeen) attachSignal(tX, tY); }; // 再走一次:訊號回到你手上(僅 fine+非低敏,attach 內部把關)
    addEventListener("scrollend", done, { once: true });
    setTimeout(done, 2600); // Safari 無 scrollend 的後備
    scrollTo({ top: 0, behavior: reduceMotion ? "auto" : "smooth" });
    history.replaceState(null, "", "#hook");
    focusPower();
  });

  padToggle.addEventListener("click", () => {
    if (!powered) return;
    if (!padOn){ padVoice = buildPadVoice(); padOn = true; kick(); }
    else { padVoice.stop(); padVoice = null; padOn = false; }
    padToggle.setAttribute("aria-pressed", String(padOn));
    padToggle.textContent = padOn ? "■ 靜音" : "▶ 發聲";
    softBlip();
  });

  $("padVol").addEventListener("input", (e) => {
    if (padVoice) padVoice.g.gain.setTargetAtTime(0.5 * (e.target.value / 100), ctx.currentTime, 0.05);
  });

  // XY:X=聲像+五聲音階音高(無錯音);Y=距離感(濾波+殘響比+微音量)——空間映射契約
  let lastTrail = 0;
  pad.addEventListener("pointermove", (e) => {
    const r = pad.getBoundingClientRect();
    const x = Math.min(Math.max((e.clientX - r.left) / r.width, 0), 1);
    const y = Math.min(Math.max((e.clientY - r.top) / r.height, 0), 1);
    dot.style.left = (x * 100) + "%"; dot.style.top = (y * 100) + "%";
    if (powered && !reduceMotion && performance.now() - lastTrail > 60){ // 光跟手走(視覺對位)
      lastTrail = performance.now();
      const t = document.createElement("span"); t.className = "trail";
      t.style.left = (x * 100) + "%"; t.style.top = (y * 100) + "%";
      pad.appendChild(t);
      t.animate([{opacity:.35, transform:"translate(-50%,-50%) scale(1)"},{opacity:0, transform:"translate(-50%,-50%) scale(.4)"}],
        {duration:700, easing:"ease-out"}).onfinish = () => t.remove();
    }
    if (padVoice){
      const f0 = PENTA[Math.min(PENTA.length - 1, Math.floor(x * PENTA.length))];
      padVoice.o1.frequency.setTargetAtTime(f0, ctx.currentTime, 0.03);
      padVoice.o2.frequency.setTargetAtTime(f0 * 2.003, ctx.currentTime, 0.03);
      padVoice.panN.pan.setTargetAtTime(x * 2 - 1, ctx.currentTime, 0.03);            // X=聲像
      padVoice.f.frequency.setTargetAtTime(500 + (1 - y) * 2600, ctx.currentTime, 0.03); // Y=亮度(近=亮)
      reverb.gain.setTargetAtTime(0.08 + y * 0.3, ctx.currentTime, 0.05);              // Y=遠(殘響比升)
    }
  });

  // 置中跳轉(使用者回饋 2026-08-16):index 鍵把「內容」帶到畫面中央,而非把
  // 區塊頂(含 30vh 留白)貼到視窗頂、內容擠在下緣。內容比視窗矮=置中;
