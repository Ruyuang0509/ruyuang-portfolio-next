  }

  // 導覽列:預設收起,滑鼠移頂自動展開、離開自動收回;把手鈕=鍵盤/觸控的後備(回饋:按鈕切換→感應)
  {
    const nav = document.querySelector(".transport"), fold = $("navFold");
