---
import "../styles/global.css";
import TransportNav from "../components/TransportNav.astro";
import OutputBus from "../components/OutputBus.astro";
import SignalCursor from "../components/SignalCursor.astro";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const canonical = new URL(Astro.url.pathname.replace(/\/?$/, "/"), Astro.site).href; // K-72 正式切換;結尾斜線正規化
---

<html lang="zh-Hant-TW">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#070503" /><!-- 外框/瀏覽器鑲邊偏暗(視口外的白不是頁面塗得到的) -->
    <title>研究方向:混合多聲道監聽 — 如願</title>
    <meta name="description" content="研究方向摘要:以精簡揚聲器結合開放式耳機,降低多聲道監聽的建置與理解門檻。" />
    <!-- K-40 正式切換(K-72) -->
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content="研究方向:混合多聲道監聽 — 如願" />
    <meta property="og:description" content="研究方向摘要:以精簡揚聲器結合開放式耳機,降低多聲道監聽的建置與理解門檻。" />
    <meta property="og:type" content="article" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="如願 — 訊號的旅程" />
    <meta property="og:locale" content="zh_TW" />
    <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
    <link rel="icon" href={`${base}/favicon-32.png`} type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href={`${base}/apple-touch-icon.png`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=Noto+Sans+TC:wght@400;500;700;900&display=swap" />
    <script is:inline>try { sessionStorage.setItem("inner", "1"); } catch {}</script><!-- K-69 批判E:Back 回歸不帶 referrer——內頁留麵包屑,旅程頁讀後即銷 -->
  </head>
  <body>
    <div class="chassis">
      <TransportNav subpage />
      <div class="inner">
        <article class="panel dossier">
          <span class="plate">MASTER OUT · RESEARCH</span>
          <div class="panel-body">
            <p class="orient">研究方向摘要 · 計畫書全文於備審資料繳交</p>
            <h1 class="dossier-title">混合多聲道監聽</h1>
            <p class="dossier-summary">多聲道監聽的體驗很好,但建置門檻與理解門檻都高。這個研究問的是:能不能用精簡的揚聲器配置,結合開放式耳機的聯動,把這件事變得可負擔、可理解?</p>

            <section class="dfield">
              <h2 class="dlabel">問題</h2>
              <p>完整的多聲道監聽環境需要空間、設備與聲學知識,三者都是門檻。一般創作者與學習者因此停在立體聲——不是不想要,是進不去。</p>
            </section>

            <div class="dossier-grid">
              <section class="dfield">
                <h2 class="dlabel">路徑</h2>
                <p>以精簡揚聲器配置結合開放式耳機:耳機補足聲道、揚聲器保留空間感,兩者聯動,降低建置成本同時保住多聲道的知覺價值。</p>
              </section>
              <section class="dfield">
                <h2 class="dlabel">文獻定位</h2>
                <p>延伸自該所論文「開放式耳機與多聲道監聽系統的聯動應用研究」所指出的未來方向——本計畫正落在其開放問題上,不是平行起步。</p>
              </section>
            </div>

            <section class="dfield">
              <h2 class="dlabel">規劃</h2>
              <p>研一:聲學與訊號處理的技術基礎(Pure Data 已提前自學,完成跨模態映射互動面板);研二:改良耳機端架構,鋪墊論文。長期目標是消費級聲響產品的研發與體驗設計——讓「聲學大眾化」從口號變成產品。</p>
            </section>

            <section class="dfield">
              <h2 class="dlabel">狀態</h2>
              <ul class="evlist">
                <li><span class="mono evk">PROPOSAL</span><span>計畫書 v1 · 2026-07-24</span></li>
                <li><span class="mono evk">METHOD</span><span>Pure Data 自學中(該所正式課程,提前起步)</span></li>
                <li><span class="mono evk">THESIS</span><span>用視覺與互動能力,降低聲學的理解門檻</span></li>
              </ul>
            </section>

            <p class="dossier-summary"><a href={`${base}/#master`}>← 回到旅程的 MASTER OUT</a></p><!-- 錨點必須是旅程頁現有的站點 id -->
          </div>
          <div class="ticks" aria-hidden="true"></div>
        </article>
      </div>
      <OutputBus subpage />
      <SignalCursor />
    </div>
  </body>
</html>
