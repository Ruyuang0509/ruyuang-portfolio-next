---
import { getCollection, render } from "astro:content";
import "../../styles/global.css";
import TransportNav from "../../components/TransportNav.astro";
import OutputBus from "../../components/OutputBus.astro";
import SignalCursor from "../../components/SignalCursor.astro";

export async function getStaticPaths() {
  const works = await getCollection(
    "works",
    ({ data }) => data.tier === "featured" || (data.tier === "rack" && data.detail === true)
  );
  return works.map((w) => ({ params: { slug: w.id }, props: { work: w } }));
}

const { work } = Astro.props;
const { Content } = await render(work);
const d = work.data;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
// 內頁「回到旅程」對應站點(K-35 遷移後改站內錨點)
const beatMap: Record<string, string> = { "pd-crossmodal": "#station", "hamlet-story-mv": "#cinema", "guide-videos": "#field", "portfolio-site": "#gen" };
const beat = beatMap[work.id] ?? "";
// 開場款式依主題(回饋:DOSSIER 也上全屏開場,且各主題各異)
const fxMap: Record<string, string> = { "pd-crossmodal": "xy", "hamlet-story-mv": "cinema", "guide-videos": "field" };
const fx = fxMap[work.id] ?? "stamp";
const canonical = new URL(Astro.url.pathname.replace(/\/?$/, "/"), Astro.site).href; // K-72 正式切換;結尾斜線正規化
---

<html lang="zh-Hant-TW" data-room="paper"><!-- K-27 證據紙房間:dossier 深讀=正極性。房間綁路由,非使用者偏好 -->
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#070503" /><!-- 外框/瀏覽器鑲邊偏暗(視口外的白不是頁面塗得到的) -->
    <meta name="color-scheme" content="dark" /><!-- v4 暖暗閱讀室 -->
    <title>{d.title} — 如願</title>
    <meta name="description" content={d.summary} />
    <!-- K-40 正式切換(K-72) -->
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={`${d.title} — 如願`} />
    <meta property="og:description" content={d.summary} />
    <meta property="og:type" content="article" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="如願 — 訊號的旅程" />
    <meta property="og:locale" content="zh_TW" />
    <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
    <link rel="icon" href={`${base}/favicon-32.png`} type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href={`${base}/apple-touch-icon.png`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=Noto+Sans+TC:wght@400;500;700;900&display=swap" />
    <script is:inline>try { sessionStorage.setItem("inner", "1"); } catch {}</script><!-- K-69 批判E:Back 回歸不帶 referrer——內頁留麵包屑,旅程頁讀後即銷 -->
  </head>
  <body>
    <a class="skip-link" href="#main">跳到主要內容</a>
    <!-- 全屏開場(純 CSS:無 JS 也演完並消失;pointer-events:none 永不擋操作;reduced-motion 整層不演) -->
    <div class="dfx" data-fx={fx} aria-hidden="true">
      <span class="dfx-x"></span><span class="dfx-y"></span><span class="dfx-dot"></span>
      <span class="dfx-tag">{(d.channel ?? d.kind.toUpperCase()) + " · DOSSIER"}</span>
    </div>
    <div class="chassis">
      <TransportNav subpage beat={beat} />
      <div class="inner">
        <article class="panel dossier" id="main" tabindex="-1">
          <span class="plate">{d.channel ?? d.kind.toUpperCase()} · DOSSIER</span>
          <div class="panel-body">
            <p class="orient">{d.tags.join(" · ")} · {d.year}</p>
            <h1 class="dossier-title">{d.title}</h1>
            <p class="dossier-summary">{d.summary}</p>

            {d.ytVideos.length > 0 && (
              <div class="ytgrid"><!-- K-70:縮圖卡=純外連(本地 webp 縮圖,零第三方請求)。站內 iframe 內嵌經審查撤下:
                round-e 裁決「影片交付=in-repo 自架定案」——未營利頻道仍可能被投放廣告,點播後會污染本站「無廣告」宣示;
                外連把廣告留在 YouTube 站上。站內播放依 K-03 自架路線,或使用者明令改判後再裝回 -->
                {d.ytVideos.map((v) => (
                  <a class="ytcard" href={`https://youtu.be/${v.id}`} target="_blank" rel="noopener">
                    <img src={`${base}${v.poster}`} alt={v.title} width="640" height="360" />
                    <span class="ytplay" aria-hidden="true">▶</span>
                    <span class="ytname">{v.title} · YouTube ↗</span>
                  </a>
                ))}
              </div>
            )}

            {d.media && (
              <figure class="dmedia">
                <video
                  controls
                  preload="none"
                  playsinline
                  poster={d.media.poster ? `${base}${d.media.poster}` : undefined}
                >
                  <source src={`${base}${d.media.video}`} type="video/mp4" />
                  {d.media.tracks.map((t) => (
                    <track kind="captions" src={`${base}${t.src}`} srclang={t.srclang} label={t.label} />
                  ))}
                </video>
                {d.media.note && <figcaption class="dmedia-note">{d.media.note}</figcaption>}<!-- K-67:圖說是完整中文句,不是儀表標籤——回內文字體 -->
              </figure>
            )}

            <div class="dossier-grid">
              <section class="dfield">
                <h2 class="dlabel">角色與作者性</h2>
                <p>{d.role}</p>
              </section>
              <section class="dfield">
                <h2 class="dlabel">AI 參與聲明</h2>
                <p>{d.aiDisclosure}</p>
              </section>
            </div>

            <section class="dfield">
              <h2 class="dlabel">證據鏈</h2>
              <ul class="evlist">
                {d.evidence.map((e) => (
                  <li><span class="mono evk">{e.label}</span><span>{e.value}</span></li>
                ))}
                {d.approval && (
                  <li><span class="mono evk">APPROVAL</span><span>{d.approval.by} · {d.approval.date} · {d.approval.scope}</span></li>
                )}
              </ul>
            </section>

            <section class="dbody">
              <Content />
            </section>
          </div>
          <div class="ticks" aria-hidden="true"></div>
        </article>
      </div>
      <OutputBus subpage />
      <SignalCursor />
    </div>
  </body>
</html>
